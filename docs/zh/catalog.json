  "principles": [
    {
      "key": "cpu:integer",
      "原理": "64 位整数混合运算",
      "实现": "加法、异或、位移旋转和乘法构成确定性运算链；循环输出 checksum。",
      "限制": "主要观察整数执行路径；不保证特定指令端口或 NEON 覆盖。"
    },
    {
      "key": "cpu:floating_point",
      "原理": "标量双精度浮点运算",
      "实现": "循环执行 double 乘加、差分与数值范围调整，再对结果位模式计算 checksum。",
      "限制": "编译器可优化代码，但没有显式承诺 SIMD/FMA 指令。"
    },
    {
      "key": "cpu:matrix",
      "原理": "确定性矩阵乘法",
      "实现": "三重循环执行矩阵乘加，输入由种子生成，结果映射为 checksum。",
      "限制": "属于软件矩阵核，不等于专用矩阵指令或 NPU 负载。"
    },
    {
      "key": "cpu:memory",
      "原理": "工作集随机读写",
      "实现": "种子生成工作集，根据状态选择索引，读改写并抽样归并 checksum。",
      "限制": "改变工作集可改变缓存/内存压力；不是完整 DRAM 故障测试。"
    },
    {
      "key": "cpu:mixed",
      "原理": "整数浮点矩阵内存混合",
      "实现": "按混合后端组合执行多类确定性计算，提高多种路径的活动量。",
      "限制": "实际功耗与瓶颈需测量，名称不证明最大功耗。"
    },
    {
      "key": "cpu:null",
